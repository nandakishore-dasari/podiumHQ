# ==============================================================================
# PodiumHQ — DevSecOps Environment Variables Template
# Copy this file to .env for local Docker Compose execution.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Project & Runtime Metadata
PROJECT_NAME=PodiumHQ
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration (PostgreSQL)
# Note: For local Docker Compose, host is 'postgres'
POSTGRES_DB=podiumhq_db
POSTGRES_USER=podium_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://podium_user:replace_with_strong_password_in_production@postgres:5432/podiumhq_db

# FastAPI Application Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://podiumhq.local
RUN_MIGRATIONS=true
API_V1_PREFIX=/api

# Container Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=3000
